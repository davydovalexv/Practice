#!/usr/bin/env bash
# Обёртка: docker compose up → stop host ollama + pull модели; down → stop host ollama
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

stop_host_ollama() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl stop ollama 2>/dev/null || true
  fi
}

cmd="${1:-}"
if [[ -n "$cmd" ]]; then
  shift
fi

case "$cmd" in
  up)
    stop_host_ollama
    exec docker compose up "$@"
    ;;
  down)
    docker compose down "$@"
    stop_host_ollama
    ;;
  "")
    exec docker compose
    ;;
  *)
    exec docker compose "$cmd" "$@"
    ;;
esac
